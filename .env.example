# Copy this file to .env and adjust if needed. None of these are required
# to run the demo -- they all default to official provider SANDBOX/TEST
# keys (safe, public, documented by each provider) if left unset.

# --- Database -----------------------------------------------------------
# DATABASE_URL=sqlite:///./data/captcha_tool.db

# --- Google reCAPTCHA v2 official test keys (always pass) ---------------
# Docs: https://developers.google.com/recaptcha/docs/faq
# RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- hCaptcha official test keys (always pass) ---------------------------
# Docs: https://docs.hcaptcha.com/#integration-testing-test-keys
# HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
# HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# --- Cloudflare Turnstile official test keys (always pass) ---------------
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- To test against YOUR OWN real site/keys instead, set real values ---
# (never commit real secret keys to source control)
# RECAPTCHA_SITE_KEY=...
# RECAPTCHA_SECRET_KEY=...

# --- Custom OCR solver tuning --------------------------------------------
# OCR_CONFIDENCE_THRESHOLD=55
# TESSERACT_CMD=/usr/bin/tesseract

# --- Reporting -------------------------------------------------------------
# THIRDPARTY_COST_PER_SOLVE_USD=0.0010

# --- Server ----------------------------------------------------------------
# APP_HOST=0.0.0.0
# APP_PORT=8000
